# Production settings for the dashboard on the VPS. Copy to .env:
#   cp .env.production.example .env
#
# The API's admin base URL. Baked into the build (browser and server code), so
# deploy.sh rebuilds after any change. The API must allow this dashboard's
# address: its .env needs ADMIN_BASE_URL=https://slimshot-admin.techfamz.com.
NEXT_PUBLIC_API_BASE=https://slimshot-server.techfamz.com/api/admin/v1
